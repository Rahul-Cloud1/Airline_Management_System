# Example environment variables for local development
# Do NOT commit real secrets. This file is a template you can copy to ".env" and edit locally.

# Global service credentials (defaults match current project defaults)
SECURITY_USER_NAME=root
SECURITY_USER_PASSWORD=Rahul@1234

# Datasource credentials (used by all services unless overridden)
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=Rahul@1234

# Config server admin credentials
CONFIG_SERVER_ADMIN_USERNAME=root
CONFIG_SERVER_ADMIN_PASSWORD=Rahul@1234

# Config server client (for services connecting to config server)
CONFIG_SERVER_CLIENT_USERNAME=root
CONFIG_SERVER_CLIENT_PASSWORD=Rahul@1234

# If your config repo is private
# GIT_USERNAME=your-git-username
# GIT_TOKEN=your-git-token
